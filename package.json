{
  "name": "system-design-lab",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm content:build && pnpm --filter @sdl/web dev",
    "content:check": "node --import tsx scripts/content.ts --check",
    "content:build": "node --import tsx scripts/content.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint apps packages scripts tests",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "build": "pnpm content:build && pnpm typecheck && pnpm --filter @sdl/web build",
    "preview": "pnpm --filter @sdl/web preview",
    "format": "prettier --write apps packages scripts tests *.ts *.js *.json",
    "format:check": "prettier --check apps packages scripts tests *.ts *.js *.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.12.0",
    "globals": "^16.5.0",
    "prettier": "3.6.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
